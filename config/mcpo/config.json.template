{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "pal": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/BeehiveInnovations/pal-mcp-server.git", "pal-mcp-server"],
      "env": {
        "OPENAI_API_KEY": "{{LITELLM_MASTER_KEY}}",
        "OPENAI_BASE_URL": "http://localhost:4000/v1"
      }
    }
  }
}
