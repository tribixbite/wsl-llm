[Unit]
Description=Qwen3-Coder-Next LLM Server
After=network.target

[Service]
Type=simple
User=matilda
WorkingDirectory=/home/matilda
ExecStart=/home/matilda/llama.cpp/build/bin/llama-server --model /home/matilda/unsloth/Qwen3-Coder-Next-GGUF/Qwen3-Coder-Next-UD-Q3_K_XL.gguf --host 0.0.0.0 --port 8080 --ctx-size 131072 --n-gpu-layers 999 --jinja
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/matilda/qwen-server.log
StandardError=append:/home/matilda/qwen-server.log

[Install]
WantedBy=multi-user.target
